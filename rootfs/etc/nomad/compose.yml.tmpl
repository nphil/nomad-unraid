# Rendered at every start by nomad-entrypoint (envsubst). This is upstream's
# management_compose.yaml with three changes:
#   * the admin image is pinned to the NOMAD version this container image was built for,
#     so updating NOMAD means updating this container (Docker tab, like any Unraid app);
#   * the sidecar updater is gone, because updates come from outside now;
#   * every path is inside this container, which is what makes the whole thing portable.
name: project-nomad                  # NOMAD hard-codes the network project-nomad_default
services:
  admin:
    image: ghcr.io/crosstalk-solutions/project-nomad:v${NOMAD_VERSION}
    container_name: nomad_admin          # NOMAD finds its own container by this name
    restart: unless-stopped
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "127.0.0.1:18080:8080"           # reached only through the proxy on :80
    volumes:
      - /data:/app/storage               # NOMAD mounts child apps from this same source
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - NODE_ENV=production
      - TZ=${TZ}
      - NOMAD_STORAGE_PATH=/data
      - PORT=8080
      - HOST=0.0.0.0
      - LOG_LEVEL=info
      - APP_KEY=${APP_KEY}
      - URL=${PUBLIC_URL}
      - DB_HOST=mysql
      - DB_PORT=3306
      - DB_DATABASE=nomad
      - DB_NAME=nomad
      - DB_USER=nomad_user
      - DB_PASSWORD=${DB_PASSWORD}
      - DB_SSL=false
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - DISABLE_COMPRESSION=false
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  mysql:
    image: mysql:8.0
    container_name: nomad_mysql
    restart: unless-stopped
    environment:
      - MYSQL_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
      - MYSQL_DATABASE=nomad
      - MYSQL_USER=nomad_user
      - MYSQL_PASSWORD=${DB_PASSWORD}
    volumes:
      - /config/mysql:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 10s
      retries: 30

  redis:
    image: redis:7-alpine
    container_name: nomad_redis
    restart: unless-stopped
    volumes:
      - /config/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 10s
      retries: 10

  disk-collector:
    # Needs / as a shared mount; the entrypoint makes it so inside this container only,
    # never on the host. What it reports is this container's view: /config and /data.
    image: ghcr.io/crosstalk-solutions/project-nomad-disk-collector:latest
    container_name: nomad_disk_collector
    restart: unless-stopped
    volumes:
      - /:/host:ro,rslave
      - /data:/storage
